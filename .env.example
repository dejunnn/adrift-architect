# Warning: This file should not contain sensitive information. Use as template for actual .env file.

# ---------------------------------------------------------------------------
# API Credentials
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# LLM Provider and Model Configuration
# ---------------------------------------------------------------------------
# budget for (reasoning and) output tokens. (supported models only)
ADRIFT_MAX_TOKENS=20000
# claude-haiku-4-5-20251001 | claude-sonnet-5 | claude-opus-5
ADRIFT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol
ADRIFT_OPENAI_MODEL=gpt-5.6-luna
# qwen/qwen3.6-27b | qwen/qwen3.8-27b | openai/gpt-oss-20b | openai/gpt-oss-120b
ADRIFT_GROQ_MODEL=openai/gpt-oss-120b
# liquid/lfm-2.5-2.6b:free | z-ai/glm-5.2:free | nvidia/nemotron-3-super-120b-a12b:free | dots-studio/dots-3-note-preview:free
ADRIFT_OPENROUTER_MODEL=z-ai/glm-5.2:free
# gemma-4-31b-it | gemini-3.1-flash-lite | gemini-3.5-flash-lite
ADRIFT_GEMINI_MODEL=gemini-3.1-flash-lite
# qwen3.5:latest | gemma4:latest |qwen3.5:9b-mlx | gemma4:12b-mlx | mistral:latest | llama3.1:latest
ADRIFT_OLLAMA_MODEL=qwen3.5:9b-mlx

# claude-haiku-4-5 does not support thinking - use none
ADRIFT_ANTHROPIC_EFFORT=medium
ADRIFT_OPENAI_EFFORT=medium
# qwen/qwen3.6-27b does not support thinking - use none
ADRIFT_GROQ_EFFORT=medium
ADRIFT_OPENROUTER_EFFORT=medium
# gemma-4-31b-it supports only "high" or "minimal" - use "high"
ADRIFT_GEMINI_EFFORT=medium
ADRIFT_OLLAMA_THINK=medium

ADRIFT_OLLAMA_HOST=http://localhost:11434
ADRIFT_OLLAMA_KEEP_ALIVE=5m

# ---------------------------------------------------------------------------
# Batch Configuration. Only for --mode batch (OpenAI and Anthropic only)
# ---------------------------------------------------------------------------
ADRIFT_BATCH_POLL_SECONDS=20
ADRIFT_BATCH_TIMEOUT_SECONDS=86400